{
  "$defs": {
    "DiagnosticFix": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "operation": {
          "enum": [
            "add",
            "remove",
            "replace"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "operation",
        "path"
      ],
      "title": "DiagnosticFix",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://recipeflow.dev/schemas/recipeflow-diagnostic-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^RF\\d{3}$",
      "title": "Code",
      "type": "string"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "fix": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticFix"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "path": {
      "default": "",
      "title": "Path",
      "type": "string"
    },
    "related_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Related Paths",
      "type": "array"
    },
    "schema_version": {
      "const": "recipeflow.diagnostic/v1",
      "default": "recipeflow.diagnostic/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "suggestions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Suggestions",
      "type": "array"
    }
  },
  "required": [
    "code",
    "severity",
    "message"
  ],
  "title": "Diagnostic",
  "type": "object"
}
