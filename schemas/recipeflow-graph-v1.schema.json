{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "consumes",
            "produces",
            "requires"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "MaterialNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "material",
          "default": "material",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "role": {
          "enum": [
            "ingredient",
            "intermediate",
            "final",
            "waste",
            "garnish"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "role"
      ],
      "title": "MaterialNode",
      "type": "object"
    },
    "OperationNode": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "operation",
          "default": "operation",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "operation_kind": {
          "enum": [
            "setup",
            "transform"
          ],
          "title": "Operation Kind",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "required": [
        "id",
        "label",
        "operation_kind",
        "action"
      ],
      "title": "OperationNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "final_material_ids": {
      "items": {
        "type": "string"
      },
      "title": "Final Material Ids",
      "type": "array"
    },
    "nodes": {
      "items": {
        "discriminator": {
          "mapping": {
            "material": "#/$defs/MaterialNode",
            "operation": "#/$defs/OperationNode"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MaterialNode"
          },
          {
            "$ref": "#/$defs/OperationNode"
          }
        ]
      },
      "title": "Nodes",
      "type": "array"
    },
    "recipe_id": {
      "title": "Recipe Id",
      "type": "string"
    },
    "schema_version": {
      "const": "recipeflow.graph/v1",
      "default": "recipeflow.graph/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "recipe_id",
    "title",
    "nodes",
    "edges",
    "final_material_ids"
  ],
  "title": "RecipeGraph",
  "type": "object"
}
